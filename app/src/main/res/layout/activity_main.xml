<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:visibility="visible">


    <androidx.cardview.widget.CardView
        android:id="@+id/blok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFFFF"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        app:cardCornerRadius="20dp"
        android:backgroundTint="@color/card_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

        <TextView
            android:id="@+id/tvText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="26sp"
            android:textColor="@color/text_color"
            android:textStyle="bold"
            android:text="TextView" />


            <Button
                android:id="@+id/btnChangeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zmień teskt"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnChangeColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zmień kolor tekstu"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnChangeBg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zmień tło"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnTrybAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto-zmiana trybu"
                android:layout_weight="1"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchNight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Tryb nocny" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Przezroczystosc Tesktu" />

            <SeekBar
                android:id="@+id/seekBarTranspText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="10"
                android:max="10"
                android:layout_margin="20px"/>

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Przezroczystosc bloku" />

            <SeekBar
                android:id="@+id/seekBarTranspBloku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="100"
                android:max="100"
                android:layout_margin="20px"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tlo1" />

</androidx.constraintlayout.widget.ConstraintLayout>